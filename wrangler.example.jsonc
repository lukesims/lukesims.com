{
  "$schema": "./node_modules/wrangler/config-schema.json",

  "main": "@astrojs/cloudflare/entrypoints/server",
  "name": "<WORKER_NAME>",

  "compatibility_date": "<COMPATIBILITY_DATE>",
  "compatibility_flags": [
    "disable_nodejs_process_v2",
    "global_fetch_strictly_public",
    "nodejs_compat"
  ],

  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },

  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/client",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "none"
  },

  "observability": {
    "enabled": true
  },

  "ratelimits": [
    {
      "namespace_id": "1001",
      "name": "EMAIL_RATE_LIMITER",
      "simple": { "limit": 1, "period": 60 }
    }
  ],

  "env": {
    "production": {
      "routes": [{ "pattern": "<PRODUCTION_DOMAIN>", "custom_domain": true }],
      "vars": {
        "PUBLIC_SITE_URL": "<PUBLIC_SITE_URL>",
        "ALLOWED_DOMAINS": "<ALLOWED_DOMAINS>",
        "PUBLIC_REPO_URL": "<PUBLIC_REPO_URL>",

        "MAILGUN_BASE_URL": "<MAILGUN_BASE_URL>",
        "MAILGUN_DOMAIN": "<MAILGUN_DOMAIN>",
        "FROM_EMAIL": "<FROM_EMAIL>",

        "SENTRY_ENABLED": "true",
        "PUBLIC_SENTRY_DEBUG": "false",
        "PUBLIC_SENTRY_ENV": "production",
        "PUBLIC_SENTRY_DSN": "<PUBLIC_SENTRY_DSN>",

        "PUBLIC_TURNSTILE_SITE_KEY": "<PUBLIC_TURNSTILE_SITE_KEY>"
      },
      "version_metadata": {
        "binding": "CF_VERSION_METADATA"
      },
      "ratelimits": [
        {
          "namespace_id": "1001",
          "name": "EMAIL_RATE_LIMITER",
          "simple": { "limit": 1, "period": 60 }
        }
      ]
    },
    "staging": {
      "routes": [{ "pattern": "<STAGING_DOMAIN>", "custom_domain": true }],
      "vars": {
        "PUBLIC_SITE_URL": "<PUBLIC_SITE_URL>",
        "ALLOWED_DOMAINS": "<ALLOWED_DOMAINS>",
        "PUBLIC_REPO_URL": "<PUBLIC_REPO_URL>",

        "MAILGUN_BASE_URL": "<MAILGUN_BASE_URL>",
        "MAILGUN_DOMAIN": "<MAILGUN_DOMAIN>",
        "FROM_EMAIL": "<FROM_EMAIL>",

        "SENTRY_ENABLED": "true",
        "PUBLIC_SENTRY_DEBUG": "false",
        "PUBLIC_SENTRY_ENV": "staging",
        "PUBLIC_SENTRY_DSN": "<PUBLIC_SENTRY_DSN>",

        "PUBLIC_TURNSTILE_SITE_KEY": "<PUBLIC_TURNSTILE_SITE_KEY>"
      },
      "version_metadata": {
        "binding": "CF_VERSION_METADATA"
      },
      "ratelimits": [
        {
          "namespace_id": "1001",
          "name": "EMAIL_RATE_LIMITER",
          "simple": { "limit": 1, "period": 60 }
        }
      ]
    }
  }
}
