---
import { getEntries, render, type CollectionEntry } from "astro:content";

import Excerpt from "~/components/excerpt.astro";
import FormattedDate from "~/components/formatted-date.astro";
import { Card } from "~/components/card";
import { Chip } from "~/components/chip";
import { Heading, styles as headingStyles } from "~/components/heading";

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const categories = (await getEntries(post.data.categories)).filter((c) => c);
const { Content } = await render(post);
---

<article class="relative flex">
  <a href={`/blog/${post.id}`} class="group flex w-full focus:outline-none">
    <Card
      className="flex w-full flex-col justify-around gap-3 p-5 pb-3 select-none group-hover:border-blue-600 group-focus:border-blue-600"
    >
      <Heading
        level="h2"
        className={headingStyles({
          level: "h3",
          class:
            "no-underline decoration-stone-400 decoration-dashed decoration-4 underline-offset-4 group-hover:text-blue-600 group-focus:text-blue-600 group-focus:underline",
        })}>{post.data.title}</Heading
      >

      <div class="line-clamp-3 text-balance">
        <Excerpt maxLength={150}>
          {post.body ? <Content /> : post.data.description}
        </Excerpt>
      </div>

      <div>
        {
          categories.map((c) => (
            <Chip className="align-top mr-2 mb-2" size="sm">
              {c.data.title}
            </Chip>
          ))
        }
        <div class="font-display float-right pl-2 text-sm leading-6 font-bold">
          {
            post.data.published ? (
              <FormattedDate
                date={post.data.published}
                className="text-blue-600"
              />
            ) : (
              <span class="text-red-600">DRAFT</span>
            )
          }
        </div>
      </div>
    </Card>
  </a>
</article>
