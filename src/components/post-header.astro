---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

import { Chip } from "~/components/chip";
import { Heading } from "~/components/heading";
import StyledDate from "~/components/styled-date.astro";
import { cn } from "~/utils/styles";

interface Props {
  categories: CollectionEntry<"categories">[];
  post: CollectionEntry<"blog">;
}

const { categories, post } = Astro.props;
const { hero, published, title, updated } = post.data;

const heroImage = hero && ("url" in hero ? hero.url : hero);
const heroImageClass = hero && "url" in hero ? hero.class : undefined;
---

<header class="flex w-full flex-col items-center">
  {
    hero && (
      <div class="w-full">
        <Image
          priority
          src={heroImage!}
          alt=""
          layout="full-width"
          class={cn(
            "border-border shadow-border h-80 w-full border-4 object-cover shadow-lg md:h-90 lg:h-100 xl:h-110 2xl:h-120",
            heroImageClass,
          )}
        />
        {"credit" in hero && hero.credit && (
          <div class="mt-1.5 -mr-1.5 text-right text-sm text-stone-600">
            Photo by{" "}
            <a
              href={hero.credit.url}
              target="_blank"
              class="underline hover:text-black hover:no-underline"
            >
              {hero.credit.name}
            </a>
          </div>
        )}
      </div>
    )
  }
  <hgroup class="flex flex-col items-center gap-8 pt-12">
    <p class="flex items-center justify-center gap-8">
      {
        categories.length > 0 && (
          <span class="flex gap-2">
            {categories.map((c) => (
              <Chip size="sm">{c.data.title}</Chip>
            ))}
          </span>
        )
      }
      {
        categories.length > 0 && published && (
          <span class="font-display text-3xl leading-none opacity-10">✱</span>
        )
      }
      {
        published && (
          <span class="flex items-center justify-center gap-4">
            <StyledDate date={published} title="Published" />
            {updated && <StyledDate date={updated} title="Updated" />}
          </span>
        )
      }
    </p>
    <Heading className="text-center text-balance">{title}</Heading>
  </hgroup>
</header>
