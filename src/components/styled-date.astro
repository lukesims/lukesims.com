---
interface Props {
  className?: string;
  date: Date;
  title?: string;
}

const { className, date, title } = Astro.props;

const day = date.getDate();
const month = date.toLocaleString("en-gb", { month: "short" });
const year = date.getFullYear();
---

<time class={className} datetime={date.toISOString()}>
  {
    title && (
      <span class="text-muted-foreground block w-full text-center text-[0.75em] leading-none font-semibold uppercase">
        {title}
      </span>
    )
  }
  <span class="flex items-center justify-center gap-1">
    <span class="text-[2em] leading-none font-extrabold">
      {day}
    </span>
    <span class="flex flex-col items-center">
      <span class="text-[0.85em] leading-none font-bold uppercase">
        {month}
      </span>
      <span class="text-[0.85em] leading-none font-bold">{year}</span>
    </span>
  </span>
</time>
