---
import { format } from "date-fns";

import { Card } from "~/components/card";
import { Chip } from "~/components/chip";
import { styles as headingStyles } from "~/components/heading";
import type { FlatEntry } from "~/utils/content";
import { cn } from "~/utils/styles";

interface Props {
  experience: FlatEntry<"experience">[];
}

const { experience } = Astro.props;

function formateDate(date: Date) {
  return format(date, "MMM yy");
}
---

<section class="w-full max-w-2xl print:mb-8">
  <h2
    class={cn(
      headingStyles({ level: "h2" }),
      "relative mb-8 break-after-avoid pt-16 md:pt-32",
      "print:mb-3 print:pt-0 print:text-2xl",
    )}
  >
    <div id="experience" class="absolute -top-20 lg:-top-24 print:hidden"></div>
    Experience
  </h2>

  <ol class="w-full">
    {
      experience.map((job) => (
        <li class="mb-12 break-inside-avoid last:mb-0 print:mb-5">
          <Card className="border-3 text-left print:border-2 print:p-3 print:shadow-md">
            <div class="flex flex-col items-start justify-between gap-4 sm:flex-row print:flex-col print:gap-0">
              <div class="order-1 flex flex-wrap items-center gap-2 sm:order-2 sm:mb-4 print:relative print:-left-1 print:order-1 print:mb-3">
                <Chip className="print:px-1.5 print:py-0.25 print:text-xs">
                  {job.endDate
                    ? `${formateDate(job.startDate)} – ${formateDate(job.endDate)}`
                    : `Since ${formateDate(job.startDate)}`}
                </Chip>
                <Chip className="print:px-1.5 print:py-0.25 print:text-xs">
                  {job.location}
                </Chip>
              </div>

              <hgroup class="font-display order-1 print:order-2">
                <h3 class="mb-1 text-xl/8 font-bold print:text-base/5">
                  {job.title}
                </h3>
                <p class="mb-4 text-lg/7 font-semibold text-blue-600 print:mb-2 print:text-sm/5">
                  {job.company}
                </p>
              </hgroup>
            </div>

            <div class="text-foreground *:space-y-3! **:space-y-1.5 [&_li]:space-y-1 [&_ul]:list-outside [&_ul]:list-disc [&_ul]:pl-5 [&_ul_ul]:pt-1.5">
              <div set:html={job.body} class="text-base print:hidden" />
              <div
                set:html={job.snippet ?? job.body}
                class="hidden text-sm print:block"
              />
            </div>
          </Card>
        </li>
      ))
    }
  </ol>
</section>
