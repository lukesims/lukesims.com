---
import { getContactInfo } from "~/utils/content";

const contactInfo = await getContactInfo("cv");
---

<ul
  class="flex w-full max-w-4xl items-center justify-center gap-6 print:hidden"
>
  {
    contactInfo?.items.map(({ icon, text, url }) => (
      <li class="flex items-center">
        <i class:list={[icon, "size-7 text-blue-600"]} />

        {url ? (
          <a
            href={url}
            target="_blank"
            rel="noopener"
            class="text-foreground font-display px-1 text-lg font-medium underline decoration-blue-600 decoration-2 underline-offset-1 hover:text-blue-600 hover:no-underline focus:outline-none focus-visible:bg-black focus-visible:text-white focus-visible:decoration-white"
          >
            {text ?? url.replace(/(^\w+:|^)\/\//, "")}
          </a>
        ) : (
          <span class="text-foreground font-display ml-1 text-lg font-medium">
            {text}
          </span>
        )}
      </li>
    ))
  }
</ul>
