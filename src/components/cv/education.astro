---
import { Heading } from "~/components/heading";
import {
  Timeline,
  TimelineItem,
  TimelineItemHeading,
} from "~/components/timeline";
import type { FlatEntry } from "~/utils/content";

interface Props {
  education: FlatEntry<"education">[];
}

const { education } = Astro.props;
---

<div class="w-full max-w-lg break-inside-avoid">
  <Heading level="h2" className="relative mb-8 pt-16 md:pt-32 print:hidden">
    <div id="education" class="absolute -top-20 lg:-top-24"></div>
    Education
  </Heading>

  <Heading level="h3" className="mb-3 hidden print:block">Education</Heading>

  <Timeline>
    {
      education.map((item) => (
        <TimelineItem
          date={
            (item.startYear === item.endYear ? "" : `${item.startYear}-`) +
            item.endYear
          }
        >
          <hgroup>
            <TimelineItemHeading>{item.heading}</TimelineItemHeading>
            <p class="font-display mb-4 text-base/7 font-bold print:mb-3 print:text-sm/7">
              {item.subheading}
            </p>
          </hgroup>
          <p
            set:html={item.body}
            class="text-foreground/70 text-base print:text-sm [&_li]:mb-1 [&_li]:last:mb-0 [&_p]:mb-2 [&_p]:last:mb-0 [&_ul]:mb-2 [&_ul]:list-outside [&_ul]:list-disc [&_ul]:pl-6 [&_ul]:last:mb-0 [&_ul_ul]:mb-0 [&_ul_ul]:pt-1"
          />
        </TimelineItem>
      ))
    }
  </Timeline>
</div>
