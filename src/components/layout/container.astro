---
import type { HTMLAttributes, HTMLTag } from "astro/types";
import { cn } from "~/utils/styles";

type Props<T extends HTMLTag = "div"> = HTMLAttributes<T> & {
  as?: T;
  size?: "sm" | "md" | "lg" | "xl";
};

const {
  as: Comp = "div",
  class: className,
  size = "md",
  ...props
} = Astro.props;
---

<Comp
  class={cn(
    "mx-auto flex w-full flex-col items-center gap-8 py-8 lg:py-18 2xl:py-24",
    size === "sm" && "max-w-xl",
    size === "md" && "max-w-3xl",
    size === "lg" && "max-w-5xl",
    size === "xl" && "max-w-7xl",
    className,
  )}
  {...props}
>
  <slot />
</Comp>
