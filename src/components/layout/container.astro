---
import { cn } from "~/utils/styles";

interface Props {
  class?: string;
  size?: "sm" | "md" | "lg";
}

const { class: className, size = "md" } = Astro.props;
---

<div
  class={cn(
    "flex flex-col items-center gap-8",
    "mx-auto w-full py-8 lg:py-18 2xl:py-24",
    size === "sm" && "max-w-xl",
    size === "md" && "max-w-3xl",
    size === "lg" && "max-w-7xl",
    className,
  )}
>
  <slot />
</div>
