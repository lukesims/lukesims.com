---
import { Link } from "~/components/link";
import { QRCode } from "~/components/qr-code";
import { cn } from "~/utils/styles";

interface Props {
  className?: string;
  qrCode?: string;
}

const { className, qrCode } = Astro.props;

const year = new Date().getFullYear();
const years = year === 2025 ? "2025" : `2025&ndash;${year}`;

const qrData = qrCode || Astro.url.toString();

const links: { href: string; icon: string; text: string }[] = [
  {
    href: import.meta.env.PUBLIC_REPO_URL,
    icon: "icon-[ri--code-s-slash-fill]",
    text: "View Source",
  },
];
---

<footer
  id="page-footer"
  class={cn(
    "print:shadow-border border-border print-color-exact inset-shadow-lg xl:inset-shadow-xl flex gap-7 border-t-4 bg-blue-600 px-6 py-5 text-white inset-shadow-blue-800/60 md:px-8 md:py-6 print:mx-5 print:w-[calc(100%-2.5rem)] print:gap-5 print:border-2 print:p-0 print:shadow-md print:inset-shadow-none",
    className,
  )}
>
  <div
    class="flex flex-col items-center gap-4 text-sm md:text-base print:hidden"
  >
    <div class="flex items-center gap-2">
      {
        links.map(({ href, icon, text }) => (
          <Link
            href={href}
            className="text-white decoration-white/40 visited:text-white inline-flex items-center gap-1.5 hover:[&>i]:bg-yellow-400 active:[&>i]:bg-black"
          >
            <i class={cn("size-[1.25em] bg-white", icon)} />
            {text}
          </Link>
        ))
      }
    </div>
    <p set:html={`&copy;&nbsp;${years} Luke&nbsp;Sims`} />
  </div>

  <div class="ml-5 hidden grow items-center justify-between print:flex">
    <div class="font-display text-xs leading-relaxed font-semibold">
      <p set:html={`&copy; ${years} Luke Sims`} />
      <p class="has-[.pageNumber:empty]:hidden has-[.totalPages:empty]:hidden">
        Page <span class="pageNumber"></span>
        of <span class="totalPages"></span>
      </p>
    </div>

    <div class="font-display text-right text-xs leading-relaxed font-semibold">
      To view online scan the QR code or go to<br />
      <a href={qrData} class="text-white underline">{qrData}</a>
    </div>
  </div>

  <div class="hidden h-18 w-18.5 shrink-0 border-l-2 border-black print:block">
    <QRCode
      client:load
      className="h-full w-full"
      data={qrData}
      width={72}
      height={72}
      margin={0}
    />
  </div>
</footer>
