---
import PrintHeader from "~/components/layout/print-header.astro";
import { HeaderNav } from "~/components/layout/header-nav";
import { Logo, LogoStacked } from "~/components/logo";
import type { FlatEntry } from "~/utils/content";

interface Props {
  contactInfo?: FlatEntry<"contactInfo">;
  errorCode?: string;
  mainNav?: FlatEntry<"navs">;
  mobileNav?: FlatEntry<"navs">;
  printHeading?: string;
}

const { contactInfo, errorCode, mainNav, mobileNav, printHeading } =
  Astro.props;
---

<header class="print-color-exact flex grow items-stretch justify-center">
  <div
    class="border-border flex shrink-0 grow items-end justify-end overflow-hidden border-r-4 border-b-4 bg-yellow-400 p-0 pl-6"
  >
    <a
      href="/"
      class:list={[
        "-mr-px -mb-px md:-mr-0.5 md:-mb-0.5 xl:-mr-0.75 xl:-mb-0.75",
        errorCode
          ? "text-yellow-700 hover:text-black"
          : "text-black hover:text-yellow-700",
      ]}
    >
      <LogoStacked className="block h-18 sm:h-24.5 lg:h-38 xl:hidden" />
      <Logo className="hidden h-15 xl:block" />
    </a>
  </div>

  <div
    class:list={[
      "inset-shadow-lg xl:inset-shadow-xl relative flex grow items-end justify-start sm:grow-2 print:hidden",
      errorCode
        ? "bg-red-500 inset-shadow-red-700/65"
        : "bg-green-500 inset-shadow-green-700/65",
    ]}
  >
    {
      errorCode && (
        <div class="absolute bottom-26 flex items-start pl-6">
          <div class="xl:text-shadow-xl font-mono text-[12dvw]/[0.7] font-semibold text-white text-shadow-lg text-shadow-red-700/65">
            {errorCode}
          </div>
        </div>
      )
    }
    <HeaderNav
      client:load
      {contactInfo}
      currentPath={Astro.url.pathname}
      {mainNav}
      {mobileNav}
    />
  </div>

  <PrintHeader>{printHeading}</PrintHeader>
</header>
