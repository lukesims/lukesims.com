---
import Header from "~/components/layout/simple/header.astro";
import Footer from "~/components/layout/footer.astro";
import BaseLayout, { type Props as BaseProps } from "~/layouts/base.astro";
import { getContactInfo, getNav } from "~/utils/content";

interface Props extends BaseProps {
  errorCode?: string;
  printHeading?: string;
  qrCode?: string;
}

const { errorCode, printHeading, qrCode, ...layoutProps } = Astro.props;

const contactInfo = await getContactInfo("nav");
const mainNav = await getNav("main");
const mobileNav = await getNav("mobile");

const qrData = qrCode || Astro.url.toString();
---

<BaseLayout {...layoutProps}>
  <div class="border-border flex min-h-screen flex-col border-12 xl:border-20">
    <Header
      {contactInfo}
      {errorCode}
      {mainNav}
      {mobileNav}
      printHeading={printHeading ?? layoutProps.title}
    />
    <div class="flex grow flex-col sm:flex-row print:flex-col">
      <main
        id="main"
        class="border-border inset-shadow-lg xl:inset-shadow-xl flex flex-col items-stretch p-8 pt-10 inset-shadow-gray-600/25 sm:grow sm:items-end sm:border-r-4 print:border-0"
      >
        <slot />
      </main>
      <Footer
        className="grow flex-col items-center justify-start *:first:items-center sm:items-start sm:justify-end sm:border-0 sm:*:first:items-start print:mx-0 print:flex-row"
        qrCode={qrData}
      >
        <slot name="footer-text" slot="footer-text">
          To view online scan the QR code or go to<br />
          <a href={qrData} class="text-white underline">{qrData}</a>
        </slot>
      </Footer>
    </div>
  </div>
</BaseLayout>
