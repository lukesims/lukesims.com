---
import Footer from "~/components/layout/footer.astro";
import { Header } from "~/components/layout/header";
import BaseLayout, { type Props as BaseProps } from "~/layouts/base.astro";

interface Props extends BaseProps {
  qrCode?: string;
}

const { qrCode, ...layoutProps } = Astro.props;
---

<BaseLayout {...layoutProps}>
  <Header client:load currentPath={Astro.url.pathname} />
  <div
    class="inset-shadow-xl flex min-h-screen w-full flex-col pt-20 inset-shadow-gray-600/25 print:p-0 print:inset-shadow-none"
  >
    <main class="container mx-auto grow">
      <slot />
    </main>
    <Footer centered {qrCode} />
  </div>
</BaseLayout>
