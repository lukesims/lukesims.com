---
import Header from "~/components/layout/content/header.astro";
import Footer from "~/components/layout/footer.astro";
import { MobileNav } from "~/components/layout/mobile-nav";
import BaseLayout, { type Props as BaseProps } from "~/layouts/base.astro";
import { getContactInfo, getNav } from "~/utils/content";

interface Props extends BaseProps {
  printHeading?: string;
  qrCode?: string;
}

const { printHeading, qrCode, ...layoutProps } = Astro.props;

const contactInfo = await getContactInfo("nav");
const mainNav = await getNav("main");
const mobileNav = await getNav("mobile");

const qrData = qrCode || Astro.url.toString();
---

<BaseLayout {...layoutProps}>
  <Header
    {contactInfo}
    {mainNav}
    {mobileNav}
    printHeading={printHeading ?? layoutProps.title}
  />
  <MobileNav
    buttonClass="fixed right-6 bottom-6 sm:right-8 sm:bottom-8 z-50 border-3 lg:hidden print:hidden"
    buttonSize="lg"
    buttonVariant="secondary"
    client:load
    {contactInfo}
    currentPath={Astro.url.pathname}
    {mobileNav}
  />
  <div class="flex min-h-screen flex-col pt-24 print:min-h-auto print:p-0">
    <main
      id="main"
      class="flex grow flex-col items-center justify-center px-6 sm:px-8 lg:px-12 print:px-5"
    >
      <slot />
    </main>
    <Footer
      className="items-center *:first:items-start sm:justify-center sm:*:first:items-center"
      qrCode={qrData}
    >
      <slot name="footer-text" slot="footer-text">
        To view online scan the QR code or go to<br />
        <a href={qrData} class="text-white underline">{qrData}</a>
      </slot>
    </Footer>
  </div>
</BaseLayout>
