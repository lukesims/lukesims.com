---
import { SEO, type SEOProps } from "astro-seo";

import { Toaster } from "~/components/toast";
import "~/styles/app.css";

export interface Props
  extends Pick<
    SEOProps,
    | "canonical"
    | "description"
    | "extend"
    | "nofollow"
    | "noindex"
    | "openGraph"
    | "title"
  > {
  bodyClass?: string;
  captcha?: boolean;
}

const { bodyClass, captcha = false, ...seoProps } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <SEO
      {...seoProps}
      titleDefault="Software Developer in Essex, UK"
      titleTemplate="%s • Luke Sims"
    />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="Luke Sims" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="stylesheet" href="/fonts.css" />
    {
      captcha && (
        <script
          defer
          is:inline
          src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit"
        />
      )
    }
  </head>
  <body class={bodyClass}>
    <slot />
    <Toaster client:load />
  </body>
</html>
