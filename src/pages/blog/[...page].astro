---
export const prerender = true;

import type { InferGetStaticPropsType, GetStaticPaths } from "astro";

import { Heading } from "~/components/heading";
import Container from "~/components/layout/container.astro";
import { Pagination } from "~/components/pagination";
import PostCard from "~/components/post-card.astro";
import Layout from "~/layouts/content.astro";
import { getRenderableBlogPosts } from "~/utils/content";

export const getStaticPaths = (async ({ paginate }) => {
  const posts = (await getRenderableBlogPosts()).sort((a, b) => {
    // Put posts without a publish date (drafts) to the front
    if (!a.data.published && !b.data.published) return 0;
    if (!a.data.published) return -1;
    if (!b.data.published) return 1;
    // Otherwise sort by publish date descending
    return b.data.published.getTime() - a.data.published.getTime();
  });
  return paginate(posts, { pageSize: 9 });
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { page } = Astro.props;
---

<Layout title="Blog">
  <Container size="xl" class="gap-10">
    <Heading>Blog</Heading>

    <section class="grid grid-cols-1 gap-10 sm:grid-cols-2 lg:grid-cols-3">
      {page.data.map((post) => <PostCard post={post} />)}
    </section>

    <section>
      <Pagination page={page} baseUrl="/blog" />
    </section>
  </Container>
</Layout>
