---
export const prerender = true;

import type { GetStaticPaths } from "astro";
import { type CollectionEntry, getEntries, render } from "astro:content";

import Container from "~/components/layout/container.astro";
import PostHeader from "~/components/post-header.astro";
import Prose from "~/components/prose.astro";
import Layout from "~/layouts/content.astro";
import { getRenderableBlogPosts } from "~/utils/content";
import { useMdxComponents } from "~/utils/mdx";

export const getStaticPaths = (async () => {
  return (await getRenderableBlogPosts()).map((post) => ({
    params: { slug: post.id },
    props: post,
  }));
}) satisfies GetStaticPaths;

type Props = CollectionEntry<"blog">;

const post = Astro.props as Props;
const { description, title, categories: categoryRefs } = post.data;
const { Content } = await render(post);
const categories = (await getEntries(categoryRefs)).filter((c) => c);
---

<Layout {title} {description}>
  <Container as="article" size="xl" class="pt-6!">
    <PostHeader {categories} {post} />
    <Prose>
      <Content components={useMdxComponents()} />
    </Prose>
  </Container>
</Layout>
