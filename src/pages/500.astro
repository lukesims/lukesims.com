---
export const prerender = false;

import { Heading } from "~/components/heading";
import Layout from "~/layouts/simple.astro";

interface Props {
  error: unknown;
}

const { error } = Astro.props;
const { originPathname } = Astro;

const statusParam = Astro.url.searchParams.get("status");
const errorParam = Astro.url.searchParams.get("error");
const messageParam = Astro.url.searchParams.get("message");

let content, errorCode, heading, title;

if (statusParam) {
  errorCode = statusParam;
  heading = errorParam ?? "Error";
  content = messageParam ?? "An error occurred";
  title = `Error ${statusParam}: ${errorParam}`;
} else if (error instanceof Error) {
  errorCode = "500";
  content = error.message ?? "An error occurred";
  heading = error.name ?? "Error";
  title = `Error: ${error.name}`;
} else {
  return Astro.rewrite("/404");
}
---

<Layout noindex errorCode={errorCode} title={title}>
  <Heading>{heading}</Heading>
  <p class="mt-6 mb-2 text-2xl leading-relaxed text-pretty">{content}</p>
  {
    errorCode === "410" &&
      originPathname.match(/^\/cv\/[A-Za-z0-9]+\/view$/) && (
        <p class="text-2xl leading-relaxed text-pretty">
          <a
            class="inline-block underline hover:text-blue-600 hover:no-underline"
            href={originPathname.substring(0, originPathname.length - 5)}
          >
            {"Click here"}
          </a>
          to request a new one.
        </p>
      )
  }
</Layout>
