---
export const prerender = false;

import { Heading } from "~/components/heading";
import Layout from "~/layouts/simple.astro";
import {
  ExpiredSignatureError,
  InvalidSignatureError,
} from "~/utils/signatures";

interface Props {
  error: unknown;
}

const { error } = Astro.props;
let content: string;

if (error instanceof ExpiredSignatureError) {
  Astro.response.status = 410;
  Astro.response.statusText = "Page Expired";
  content = "That link is no longer usable.";
} else if (error instanceof InvalidSignatureError) {
  Astro.response.status = 403;
  Astro.response.statusText = "Invalid Signature";
  content = "The URL cannot be modified.";
} else {
  Astro.response.status = 500;
  Astro.response.statusText = "Internal Error";
  content = "Please try again later.";
}

const title = `Error ${Astro.response.status} • ${Astro.response.statusText}`;
---

<Layout noindex errorCode={`${Astro.response.status}`} {title}>
  <Heading>{Astro.response.statusText}</Heading>
  <p class="mt-4 text-2xl leading-relaxed text-pretty">{content}</p>
</Layout>
