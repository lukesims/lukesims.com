---
export const prerender = false;

import { getEntry } from "astro:content";

import { CvForm } from "~/components/forms/cv-form";
import { Heading } from "~/components/heading";
import Container from "~/components/layout/container.astro";
import Layout from "~/layouts/content.astro";
import { ExpiredCvError } from "~/utils/content";

const { id } = Astro.params;

if (!id) {
  return new Response(null, { status: 404, statusText: "Not found" });
}

const cv = await getEntry("cv", id);

if (!cv) {
  return new Response(null, { status: 404, statusText: "Not found" });
}

const today = new Date();
today.setHours(0, 0, 0, 0);

if (cv.data.expires && cv.data.expires <= today) {
  throw new ExpiredCvError();
}
---

<Layout noindex title="My CV">
  <Container size="sm">
    <Heading className="text-center">Curriculum Vitae</Heading>
    <p class="text-center">Thanks for checking out my CV 😊</p>
    <div class="w-full max-w-sm">
      <CvForm client:load id={id} />
    </div>
  </Container>
</Layout>
