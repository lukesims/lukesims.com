---
export const prerender = false;

import ContactInfo from "~/components/cv/contact-info.astro";
import Education from "~/components/cv/education.astro";
import Experience from "~/components/cv/experience.astro";
import { Header } from "~/components/cv/header";
import { DesktopNav, MobileNav } from "~/components/cv/nav";
import { Skills } from "~/components/cv/skills";
import Container from "~/components/layout/container.astro";
import Layout from "~/layouts/content.astro";
import { ExpiredCvError, getCv } from "~/utils/content";
import { assertUrlIsValid, ExpiredSignatureError } from "~/utils/signatures";

if (!Astro.params.id) {
  return Astro.rewrite("/404");
}

try {
  assertUrlIsValid(Astro.url);
} catch (error) {
  if (error instanceof ExpiredSignatureError) {
    return Astro.redirect(`/cv/${Astro.params.id}`);
  }
  throw error;
}

const cv = await getCv(Astro.params.id);

if (!cv) {
  return Astro.rewrite("/404");
}

const today = new Date();
today.setHours(0, 0, 0, 0);

if (cv.expires && cv.expires <= today) {
  throw new ExpiredCvError();
}

const { education, experience, skills, summary, title } = cv;
const qrCode = new URL(
  `/cv/${Astro.params.id}`,
  import.meta.env.PUBLIC_SITE_URL,
).toString();
---

<Layout
  bodyClass="print-color-exact"
  noindex
  printHeading={title}
  {qrCode}
  title="My CV"
>
  <Container
    class="text-center text-pretty lg:pt-42 2xl:pt-48 print:gap-5 print:py-0"
    size="lg"
  >
    <MobileNav client:load />
    <DesktopNav />
    <Header {title} />
    <ContactInfo />
    <div
      class="flex w-full flex-col items-center gap-8 print:block print:min-h-[calc(100vh-11.75rem)] print:columns-3 print:gap-5 print:py-5"
    >
      <p
        class="max-w-2xl text-xl print:mb-5 print:max-w-2xl print:text-sm print:text-wrap"
      >
        {summary}
      </p>
      <Skills {skills} />
      <Experience {experience} />
      <Education {education} />
    </div>
  </Container>
</Layout>
