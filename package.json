    "mailgun.js": "^12.6.0",
    "nanoid": "^5.1.6",
    "nanostores": "^1.1.0",
    "qr-code-styling": "^1.9.2",
    "radix-ui": "^1.4.3",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "sharp": "^0.34.5",
