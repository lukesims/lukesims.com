{
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler types && astro dev",
    "build": "wrangler types && astro build",
    "preview": "wrangler types && wrangler dev --ip 0.0.0.0",
    "lint": "concurrently --group --names issues,style,types 'npm run lint:issues' 'npm run lint:style' 'npm run lint:types'",
    "lint:issues": "eslint .",
    "lint:style": "prettier --check .",
    "lint:types": "wrangler types && astro check",
    "fix": "concurrently --group --names issues,style 'npm run fix:issues' 'npm run fix:style'",
    "fix:issues": "eslint --fix .",
    "fix:style": "prettier --write .",
    "test": "concurrently --group --names unit,e2e 'npm run test:unit' 'npm run test:e2e'",
    "test:unit": "vitest",
    "test:e2e": "playwright test"
  },
